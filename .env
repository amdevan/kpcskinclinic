# Use PostgreSQL in production (Vercel Postgres, Supabase, Neon, etc.)
# Format: postgresql://user:password@host:port/database
# For local dev, you can use SQLite by changing to file:./db/custom.db
# but production MUST use PostgreSQL

# Production fallback (will not crash — db.ts handles errors gracefully)
DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder

NEXTAUTH_SECRET=kpc-skin-clinic-secret-key-2026-very-secure
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@kpcskin.com
ADMIN_PASSWORD=kpc-admin-2026

# Email/SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@kpcskin.com
